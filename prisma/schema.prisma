generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Teacher {
  id      String   @id @map("id")
  name    String   @map("name")
  lessons Lesson[]

  @@map("teachers")
}

model Group {
  id      Int       @id @default(autoincrement()) @map("id")
  name    String    @unique @map("name")
  lessons Lesson[]

  @@map("groups")
}

model Student {
  studentId   Int            @id @map("student_id")
  name        String         @map("name")
  jduId       String?        @map("jdu_id")
  lessons     Lesson[]
  attendances Attendance[]

  @@map("students")
}

model Lesson {
  id                String  @id @default(cuid()) @map("id")
  studentId         Int     @map("student_id")
  teacherId         String  @map("teacher_id")
  groupId           Int     @map("group_id")
  subjectName       String  @map("subject_name")
  totalCurrentGrade Float   @default(0) @map("total_current_grade")
  totalFullGrade    Float   @default(0) @map("total_full_grade")
  percentageGrade   Float   @default(0) @map("percentage_grade")
  assignments       Json    @default("[]") @map("assignments")
  attendances       Json    @default("[]") @map("attendances")

  student Student @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectName, teacherId, groupId], map: "lessons_student_subject_teacher_group_key")
  @@map("lessons")
}

model Attendance {
  id        String   @id @default(cuid()) @map("id")
  studentId Int      @map("student_id")
  inside    Int      @map("inside")
  timeLog   DateTime? @map("time_log")
  createdAt DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@map("attendances")
}

// Better Auth Models
model User {
  id            String    @id @default(cuid()) @map("id")
  email         String    @unique @map("email")
  emailVerified Boolean   @default(false) @map("email_verified")
  name String? @map("name")
  password      String?   @map("password")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  sessions  Session[]
  accounts  Account[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  
  // Better Auth uchun majburiy bo'lgan token maydoni:
  token     String   @unique
  
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  
  // Quyidagi ikki maydon Better Auth uchun juda muhim:
  accountId          String   @map("account_id")
  providerId         String   @map("provider_id")

  password           String?  @db.Text

  refreshToken       String?  @db.Text
  accessToken        String?  @db.Text
  expiresAt          Int?
  tokenType          String?
  scope              String?
  idToken            String?  @db.Text
  sessionState       String?

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

